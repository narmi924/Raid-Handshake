eometry"/></mxCell><mxCell id="c42" value="&lt;span style=&quot;font-size:15.5px;font-weight:700;color:#0E0E10&quot;&gt;par&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B600%3B700;fontSize=15.5;fontColor=#0E0E10;align=left;verticalAlign=middle;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="44" y="460" width="45" height="26" as="geometry"/></mxCell><mxCell id="c43" value="&lt;span style=&quot;font-size:15.5px;color:#55555F&quot;&gt;Guest enrichment and welcome preparation run independently.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B600%3B700;fontSize=15.5;fontColor=#0E0E10;align=left;verticalAlign=middle;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="115" y="460" width="1135" height="26" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="410" y="620" width="790" height="28" as="geometry"/></mxCell><mxCell id="c53" value="&lt;span style=&quot;font-size:15.5px;color:#55555F&quot;&gt;A fresh transcript is required; without it the welcome draft stays blocked.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B600%3B700;fontSize=15.5;fontColor=#0E0E10;align=left;verticalAlign=middle;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="410" y="620" width="790" height="28" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="27" y="830" width="1250" height="30" as="geometry"/></mxCell><mxCell id="c65" value="&